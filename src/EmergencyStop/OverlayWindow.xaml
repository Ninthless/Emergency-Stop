<Window x:Class="EmergencyStop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmergencyStop"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized">
    <Grid IsHitTestVisible="False">
        <Viewbox Width="{Binding IndicatorSize}"
                 Height="{Binding IndicatorSize}"
                 Opacity="{Binding OverlayOpacity}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
            </Viewbox.RenderTransform>
            <Grid Width="180" Height="180">
                <local:OuterRingElement Width="180"
                                        Height="180"
                                        Kind="{Binding OuterRingStyle}"
                                        Stroke="{Binding AccentBrush}"
                                        RingSize="{Binding OuterRingSize}"
                                        RingThickness="{Binding OuterRingThickness}"
                                        Opacity="{Binding OuterRingOpacity}"
                                        Visibility="{Binding OuterRingVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                <Grid Opacity="{Binding MovementBarsOpacity}"
                      Visibility="{Binding MovementBarsVisibility}">
                    <Border Width="26"
                            Height="5"
                            Background="{Binding ForwardBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,22,0,0" />
                    <Border Width="26"
                            Height="5"
                            Background="{Binding BackwardBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,22" />
                    <Border Width="5"
                            Height="26"
                            Background="{Binding LeftBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="22,0,0,0" />
                    <Border Width="5"
                            Height="26"
                            Background="{Binding RightBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,22,0" />
                </Grid>
                <local:CrosshairElement Width="64"
                                        Height="64"
                                        Kind="{Binding CrosshairStyle}"
                                        CrosshairBrush="{Binding CrosshairBrush}"
                                        OutlineBrush="{Binding CrosshairOutlineBrush}"
                                        CrosshairSize="{Binding CrosshairSize}"
                                        CrosshairThickness="{Binding CrosshairThickness}"
                                        CrosshairGap="{Binding CrosshairGap}"
                                        OutlineThickness="{Binding CrosshairOutlineThickness}"
                                        OutlineOpacity="{Binding CrosshairOutlineOpacity}"
                                        ShowCenterDot="{Binding ShowCenterDot}"
                                        CenterDotSize="{Binding CrosshairCenterDotSize}"
                                        CenterDotOpacity="{Binding CrosshairCenterDotOpacity}"
                                        ShowOuterLines="{Binding ShowOuterCrosshairLines}"
                                        OuterLineSize="{Binding OuterCrosshairSize}"
                                        OuterLineThickness="{Binding OuterCrosshairThickness}"
                                        OuterLineGap="{Binding OuterCrosshairGap}"
                                        OuterLineOpacity="{Binding OuterCrosshairOpacity}"
                                        Opacity="{Binding CrosshairEffectiveOpacity}"
                                        Visibility="{Binding CenterCrosshairVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                <Border Width="78"
                        Height="22"
                        Background="#101820"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2"
                        Opacity="0.92"
                        Visibility="{Binding StatusBadgeVisibility}">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding AccentBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Grid Width="174"
                      Height="174"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding DirectionPadVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Width="34"
                            Height="21"
                            Background="#101820"
                            BorderBrush="{Binding ForwardBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="{Binding ForwardLabel}"
                                   Foreground="#EAF1F8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="2"
                            Grid.Column="1"
                            Width="34"
                            Height="21"
                            Background="#101820"
                            BorderBrush="{Binding BackwardBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="{Binding BackwardLabel}"
                                   Foreground="#EAF1F8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Width="34"
                            Height="21"
                            Background="#101820"
                            BorderBrush="{Binding LeftBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="{Binding LeftLabel}"
                                   Foreground="#EAF1F8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="1"
                            Grid.Column="2"
                            Width="34"
                            Height="21"
                            Background="#101820"
                            BorderBrush="{Binding RightBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="{Binding RightLabel}"
                                   Foreground="#EAF1F8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
