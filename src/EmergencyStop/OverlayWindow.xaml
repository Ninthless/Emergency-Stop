<Window x:Class="EmergencyStop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmergencyStop"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized">
    <Grid IsHitTestVisible="False">
        <Viewbox Width="{Binding IndicatorSize}"
                 Height="{Binding IndicatorSize}"
                 Opacity="{Binding OverlayOpacity}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Viewbox.RenderTransform>
                <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
            </Viewbox.RenderTransform>
            <Grid Width="180" Height="180">
                <local:OuterRingElement Width="180"
                                        Height="180"
                                        Kind="{Binding OuterRingStyle}"
                                        Stroke="{Binding AccentBrush}"
                                        RingSize="{Binding OuterRingSize}"
                                        RingThickness="{Binding OuterRingThickness}"
                                        Opacity="{Binding OuterRingOpacity}"
                                        Visibility="{Binding OuterRingVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                <Grid Opacity="{Binding MovementBarsOpacity}"
                      Visibility="{Binding MovementBarsVisibility}">
                    <Border Width="{Binding MovementBarLength}"
                            Height="{Binding MovementBarThickness}"
                            Background="{Binding ForwardBrush}"
                            CornerRadius="{Binding MovementBarCornerRadius}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="{Binding ForwardBarMargin}" />
                    <Border Width="{Binding MovementBarLength}"
                            Height="{Binding MovementBarThickness}"
                            Background="{Binding BackwardBrush}"
                            CornerRadius="{Binding MovementBarCornerRadius}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="{Binding BackwardBarMargin}" />
                    <Border Width="{Binding MovementBarThickness}"
                            Height="{Binding MovementBarLength}"
                            Background="{Binding LeftBrush}"
                            CornerRadius="{Binding MovementBarCornerRadius}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="{Binding LeftBarMargin}" />
                    <Border Width="{Binding MovementBarThickness}"
                            Height="{Binding MovementBarLength}"
                            Background="{Binding RightBrush}"
                            CornerRadius="{Binding MovementBarCornerRadius}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="{Binding RightBarMargin}" />
                </Grid>
                <local:CrosshairElement Width="64"
                                        Height="64"
                                        Kind="{Binding CrosshairStyle}"
                                        CrosshairBrush="{Binding CrosshairBrush}"
                                        OutlineBrush="{Binding CrosshairOutlineBrush}"
                                        CrosshairSize="{Binding CrosshairSize}"
                                        CrosshairThickness="{Binding CrosshairThickness}"
                                        CrosshairGap="{Binding CrosshairGap}"
                                        OutlineThickness="{Binding CrosshairOutlineThickness}"
                                        OutlineOpacity="{Binding CrosshairOutlineOpacity}"
                                        ShowCenterDot="{Binding ShowCenterDot}"
                                        CenterDotSize="{Binding CrosshairCenterDotSize}"
                                        CenterDotOpacity="{Binding CrosshairCenterDotOpacity}"
                                        ShowOuterLines="{Binding ShowOuterCrosshairLines}"
                                        OuterLineSize="{Binding OuterCrosshairSize}"
                                        OuterLineThickness="{Binding OuterCrosshairThickness}"
                                        OuterLineGap="{Binding OuterCrosshairGap}"
                                        OuterLineOpacity="{Binding OuterCrosshairOpacity}"
                                        Opacity="{Binding CrosshairEffectiveOpacity}"
                                        Visibility="{Binding CenterCrosshairVisibility}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                <Border Width="{Binding StatusBadgeWidth}"
                        Height="{Binding StatusBadgeHeight}"
                        Background="#101820"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="{Binding StatusBadgeVerticalAlignment}"
                        Margin="{Binding StatusBadgeMargin}"
                        Opacity="{Binding StatusBadgeOpacity}"
                        Visibility="{Binding StatusBadgeVisibility}">
                    <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly"
                             Margin="4,0">
                        <TextBlock Text="{Binding StatusBadgeText}"
                                   Foreground="{Binding AccentBrush}"
                                   FontSize="{Binding StatusBadgeFontSize}"
                                   FontWeight="Bold"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Viewbox>
                </Border>
                <Grid Width="180"
                      Height="180"
                      Opacity="{Binding DirectionLabelOpacity}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding DirectionPadVisibility}">
                    <Border Width="{Binding DirectionLabelWidth}"
                            Height="{Binding DirectionLabelHeight}"
                            Background="#101820"
                            BorderBrush="{Binding ForwardBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="{Binding ForwardLabelMargin}">
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 Margin="3,0">
                            <TextBlock Text="{Binding ForwardLabel}"
                                       Foreground="#EAF1F8"
                                       FontSize="{Binding DirectionLabelFontSize}"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Viewbox>
                    </Border>
                    <Border Width="{Binding DirectionLabelWidth}"
                            Height="{Binding DirectionLabelHeight}"
                            Background="#101820"
                            BorderBrush="{Binding BackwardBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="{Binding BackwardLabelMargin}">
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 Margin="3,0">
                            <TextBlock Text="{Binding BackwardLabel}"
                                       Foreground="#EAF1F8"
                                       FontSize="{Binding DirectionLabelFontSize}"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Viewbox>
                    </Border>
                    <Border Width="{Binding DirectionLabelWidth}"
                            Height="{Binding DirectionLabelHeight}"
                            Background="#101820"
                            BorderBrush="{Binding LeftBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="{Binding LeftLabelMargin}">
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 Margin="3,0">
                            <TextBlock Text="{Binding LeftLabel}"
                                       Foreground="#EAF1F8"
                                       FontSize="{Binding DirectionLabelFontSize}"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Viewbox>
                    </Border>
                    <Border Width="{Binding DirectionLabelWidth}"
                            Height="{Binding DirectionLabelHeight}"
                            Background="#101820"
                            BorderBrush="{Binding RightBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="{Binding RightLabelMargin}">
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 Margin="3,0">
                            <TextBlock Text="{Binding RightLabel}"
                                       Foreground="#EAF1F8"
                                       FontSize="{Binding DirectionLabelFontSize}"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Viewbox>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
