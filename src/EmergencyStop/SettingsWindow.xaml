<ui:FluentWindow x:Class="EmergencyStop.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Emergency Stop Settings"
                 Width="880"
                 Height="680"
                 MinWidth="760"
                 MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource WindowBackgroundBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#080808" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111821" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0E141B" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#243141" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#F4F4F4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#91A1B2" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#7E7E7E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F8F8F8" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#080808" />
        <SolidColorBrush x:Key="ControlBrush" Color="#171717" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#242424" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#303030" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#363636" />
        <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#666666" />
        <SolidColorBrush x:Key="InputBrush" Color="#101010" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#252525" />
        <SolidColorBrush x:Key="ToggleTrackBrush" Color="#242424" />
        <SolidColorBrush x:Key="ToggleBorderBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="ToggleThumbBrush" Color="#EDEDED" />
        <SolidColorBrush x:Key="SliderTrackBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#666666" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="42"
                                    Height="22"
                                    Background="{DynamicResource ToggleTrackBrush}"
                                    BorderBrush="{DynamicResource ToggleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border x:Name="Thumb"
                                        Width="16"
                                        Height="16"
                                        Background="{DynamicResource ToggleThumbBrush}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Margin="2" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="7"
                                                Padding="10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource MutedBrush}"
                                                      Width="8"
                                                      Height="4"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TinyCaps" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="54" />
        </Style>

        <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource ControlBorderHoverBrush}"
                                BorderThickness="1"
                                CornerRadius="8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}"
                                                  Background="{DynamicResource AccentBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}"
                                                  Background="{DynamicResource SliderTrackBrush}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="2"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator"
                                        Width="4"
                                        Height="20"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="SettingsTitleBar"
                      Grid.Row="0"
                      Height="40"
                      Title="Emergency Stop Settings"
                      ShowMaximize="True"
                      ShowMinimize="True"
                      ShowClose="True"
                      VerticalAlignment="Top" />

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="CONTROL"
                               Style="{StaticResource TinyCaps}"
                               Margin="2,0,0,8" />
                    <RadioButton Content="Crosshair"
                                 GroupName="SettingsNavigation"
                                 Tag="Crosshair"
                                 IsChecked="True"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton Content="Overlay"
                                 GroupName="SettingsNavigation"
                                 Tag="Overlay"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton Content="Timing"
                                 GroupName="SettingsNavigation"
                                 Tag="Timing"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavigationButton_Checked" />
                    <RadioButton Content="Keys"
                                 GroupName="SettingsNavigation"
                                 Tag="Keys"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavigationButton_Checked" />
                    <Border Height="1"
                            Background="{DynamicResource PanelBorderBrush}"
                            Margin="2,8,2,10" />
                    <TextBlock x:Name="LanguageLabel"
                               Text="Language"
                               Style="{StaticResource TinyCaps}"
                               Margin="2,0,0,4" />
                    <ComboBox x:Name="LanguageComboBox"
                              MinWidth="0"
                              Margin="0"
                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock x:Name="PageTitle"
                               Text="Crosshair"
                               FontSize="20"
                               FontWeight="Bold" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="CrosshairPage"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Quick presets"
                                               Style="{StaticResource SectionTitle}" />
                                    <WrapPanel>
                                        <Button Content="Pro Cyan"
                                                Tag="ProCyan"
                                                Style="{StaticResource PresetButton}"
                                                Click="PresetButton_Click" />
                                        <Button Content="Dot Focus"
                                                Tag="DotFocus"
                                                Style="{StaticResource PresetButton}"
                                                Click="PresetButton_Click" />
                                        <Button Content="State Adaptive"
                                                Tag="StateAdaptive"
                                                Style="{StaticResource PresetButton}"
                                                Click="PresetButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Profile"
                                               Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Show center crosshair"
                                              IsChecked="{Binding ShowCenterCrosshair, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel x:Name="CrosshairProfileControls">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Style" />
                                                <ComboBox x:Name="CrosshairStyleComboBox"
                                                          SelectedItem="{Binding CrosshairStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Color" />
                                                <ComboBox x:Name="CrosshairColorComboBox"
                                                          SelectedItem="{Binding CrosshairColorPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="CustomColorControls">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Red" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:0}}"
                                                           Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="RedSlider"
                                                    Minimum="0"
                                                    Maximum="255"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding CrosshairRed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Green" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:0}}"
                                                           Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="GreenSlider"
                                                    Minimum="0"
                                                    Maximum="255"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding CrosshairGreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Blue" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:0}}"
                                                           Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="BlueSlider"
                                                    Minimum="0"
                                                    Maximum="255"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding CrosshairBlue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="InnerLineSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Inner lines"
                                               Style="{StaticResource SectionTitle}" />
                                    <StackPanel x:Name="CrosshairGeometryControls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Length" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=CrosshairSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="CrosshairSizeSlider"
                                                Minimum="1"
                                                Maximum="24"
                                                Value="{Binding CrosshairSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Thickness" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=CrosshairThicknessSlider, Path=Value, StringFormat={}{0:0.0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="CrosshairThicknessSlider"
                                                Minimum="1"
                                                Maximum="6"
                                                Value="{Binding CrosshairThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Center gap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=CrosshairGapSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="CrosshairGapSlider"
                                                Minimum="0"
                                                Maximum="16"
                                                Value="{Binding CrosshairGap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Opacity" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=CrosshairOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="CrosshairOpacitySlider"
                                            Minimum="0.05"
                                            Maximum="1"
                                            Value="{Binding CenterCrosshairOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Outline thickness" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=CrosshairOutlineSlider, Path=Value, StringFormat={}{0:0.0}px}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="CrosshairOutlineSlider"
                                            Minimum="0"
                                            Maximum="3"
                                            Value="{Binding CrosshairOutlineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel x:Name="OutlineOpacityControls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Outline opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=CrosshairOutlineOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="CrosshairOutlineOpacitySlider"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="{Binding CrosshairOutlineOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DotAndOuterLinesSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Dot and outer lines"
                                               Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="CenterDotCheckBox"
                                              Content="Center dot"
                                              IsChecked="{Binding ShowCenterDot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel x:Name="DotControls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Dot size" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=DotSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="DotSizeSlider"
                                                Minimum="1"
                                                Maximum="8"
                                                Value="{Binding CrosshairCenterDotSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Dot opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=DotOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="DotOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="1"
                                                Value="{Binding CrosshairCenterDotOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <CheckBox Content="Outer lines"
                                              IsChecked="{Binding ShowOuterCrosshairLines, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel x:Name="OuterLineControls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Outer length" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=OuterLineSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="OuterLineSizeSlider"
                                                Minimum="1"
                                                Maximum="12"
                                                Value="{Binding OuterCrosshairSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Outer thickness" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=OuterLineThicknessSlider, Path=Value, StringFormat={}{0:0.0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="OuterLineThicknessSlider"
                                                Minimum="1"
                                                Maximum="6"
                                                Value="{Binding OuterCrosshairThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Outer gap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=OuterLineGapSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="OuterLineGapSlider"
                                                Minimum="4"
                                                Maximum="28"
                                                Value="{Binding OuterCrosshairGap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Outer opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=OuterLineOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="OuterLineOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="1"
                                                Value="{Binding OuterCrosshairOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MovementFadeSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Movement fade"
                                               Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Fade crosshair while moving"
                                              IsChecked="{Binding FadeCrosshairWhileMoving, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel x:Name="MovingOpacityControls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Moving opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=MovingCrosshairOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="MovingCrosshairOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="1"
                                                Value="{Binding MovingCrosshairOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="OverlayPage"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Window"
                                               Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Show overlay"
                                              IsChecked="{Binding IsOverlayVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Click through"
                                              IsChecked="{Binding IsClickThrough, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Open settings on startup"
                                              IsChecked="{Binding OpenSettingsOnStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Automatic updates"
                                              IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Layout"
                                               Style="{StaticResource SectionTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Indicator size" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="SizeSlider"
                                            Minimum="96"
                                            Maximum="260"
                                            Value="{Binding IndicatorSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Overlay opacity" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="OpacitySlider"
                                            Minimum="0.25"
                                            Maximum="1"
                                            Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Horizontal offset" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=OffsetXSlider, Path=Value, StringFormat={}{0:0}px}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="OffsetXSlider"
                                            Minimum="-640"
                                            Maximum="640"
                                            Value="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vertical offset" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=OffsetYSlider, Path=Value, StringFormat={}{0:0}px}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="OffsetYSlider"
                                            Minimum="-360"
                                            Maximum="360"
                                            Value="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Movement cues"
                                               Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Movement bars"
                                              IsChecked="{Binding ShowMovementBars, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="State badge"
                                              IsChecked="{Binding ShowStatusBadge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Direction key labels"
                                              IsChecked="{Binding ShowDirectionPad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel x:Name="MovementBarsControls"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="Movement bar shape" />
                                        <ComboBox x:Name="MovementBarShapeComboBox"
                                                  SelectedItem="{Binding MovementBarShape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Movement bar opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=MovementBarsOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="MovementBarsOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="1"
                                                Value="{Binding MovementBarsOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Bar length" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=MovementBarLengthSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="MovementBarLengthSlider"
                                                Minimum="10"
                                                Maximum="54"
                                                Value="{Binding MovementBarLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Bar thickness" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=MovementBarThicknessSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="MovementBarThicknessSlider"
                                                Minimum="2"
                                                Maximum="12"
                                                Value="{Binding MovementBarThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Bar distance" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=MovementBarDistanceSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="MovementBarDistanceSlider"
                                                Minimum="36"
                                                Maximum="84"
                                                Value="{Binding MovementBarDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Inactive opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=MovementBarInactiveOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="MovementBarInactiveOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="0.9"
                                                Value="{Binding MovementBarInactiveOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel x:Name="StatusBadgeControls"
                                                Margin="0,12,0,0">
                                        <TextBlock Text="State badge content" />
                                        <ComboBox x:Name="StatusBadgeContentComboBox"
                                                  SelectedItem="{Binding StatusBadgeContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Text="Badge position" />
                                        <ComboBox x:Name="StatusBadgePositionComboBox"
                                                  SelectedItem="{Binding StatusBadgePosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Badge opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=StatusBadgeOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="StatusBadgeOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="1"
                                                Value="{Binding StatusBadgeOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Badge width" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=StatusBadgeWidthSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="StatusBadgeWidthSlider"
                                                Minimum="54"
                                                Maximum="132"
                                                Value="{Binding StatusBadgeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Badge font size" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=StatusBadgeFontSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="StatusBadgeFontSizeSlider"
                                                Minimum="8"
                                                Maximum="18"
                                                Value="{Binding StatusBadgeFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Badge offset" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=StatusBadgeOffsetSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="StatusBadgeOffsetSlider"
                                                Minimum="0"
                                                Maximum="32"
                                                Value="{Binding StatusBadgeOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel x:Name="DirectionLabelControls"
                                                Margin="0,12,0,0">
                                        <TextBlock Text="Direction label style" />
                                        <ComboBox x:Name="DirectionLabelContentComboBox"
                                                  SelectedItem="{Binding DirectionLabelContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Label opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=DirectionLabelOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="DirectionLabelOpacitySlider"
                                                Minimum="0.05"
                                                Maximum="1"
                                                Value="{Binding DirectionLabelOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Label width" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=DirectionLabelWidthSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="DirectionLabelWidthSlider"
                                                Minimum="22"
                                                Maximum="54"
                                                Value="{Binding DirectionLabelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Label font size" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=DirectionLabelFontSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="DirectionLabelFontSizeSlider"
                                                Minimum="8"
                                                Maximum="16"
                                                Value="{Binding DirectionLabelFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Label distance" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=DirectionLabelDistanceSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="DirectionLabelDistanceSlider"
                                                Minimum="34"
                                                Maximum="84"
                                                Value="{Binding DirectionLabelDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Outer ring"
                                               Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Outer ring"
                                              IsChecked="{Binding ShowOuterRing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel x:Name="OuterRingControls">
                                        <TextBlock Text="Ring style" />
                                        <ComboBox x:Name="OuterRingStyleComboBox"
                                                  SelectedItem="{Binding OuterRingStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ring size" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=RingSizeSlider, Path=Value, StringFormat={}{0:0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="RingSizeSlider"
                                                Minimum="72"
                                                Maximum="170"
                                                Value="{Binding OuterRingSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ring thickness" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=RingThicknessSlider, Path=Value, StringFormat={}{0:0.0}px}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="RingThicknessSlider"
                                                Minimum="1"
                                                Maximum="8"
                                                Value="{Binding OuterRingThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ring opacity" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=RingOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="RingOpacitySlider"
                                                Minimum="0.15"
                                                Maximum="1"
                                                Value="{Binding OuterRingOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TimingPage"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Movement timing"
                                               Style="{StaticResource SectionTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Release stop estimate" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=ReleaseSlider, Path=Value, StringFormat={}{0:0}ms}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="ReleaseSlider"
                                            Minimum="35"
                                            Maximum="220"
                                            Value="{Binding ReleaseStopMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Counter-strafe estimate" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=CounterSlider, Path=Value, StringFormat={}{0:0}ms}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="CounterSlider"
                                            Minimum="15"
                                            Maximum="140"
                                            Value="{Binding CounterStopMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="READY flash window" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ElementName=FlashSlider, Path=Value, StringFormat={}{0:0}ms}"
                                                   Style="{StaticResource ValueText}" />
                                    </Grid>
                                    <Slider x:Name="FlashSlider"
                                            Minimum="25"
                                            Maximum="180"
                                            Value="{Binding ReadyFlashMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="KeysPage"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Movement keys"
                                               Style="{StaticResource SectionTitle}" />
                                    <UniformGrid Columns="2" Rows="2">
                                        <Button x:Name="ForwardKeyButton"
                                                Tag="Forward"
                                                Margin="0,0,10,10"
                                                Click="KeyButton_Click" />
                                        <Button x:Name="BackwardKeyButton"
                                                Tag="Backward"
                                                Margin="0,0,0,10"
                                                Click="KeyButton_Click" />
                                        <Button x:Name="LeftKeyButton"
                                                Tag="Left"
                                                Margin="0,0,10,0"
                                                Click="KeyButton_Click" />
                                        <Button x:Name="RightKeyButton"
                                                Tag="Right"
                                                Click="KeyButton_Click" />
                                    </UniformGrid>
                                    <TextBlock x:Name="CaptureHint"
                                               Text="Click a direction button, then press a new movement key."
                                               Style="{StaticResource Muted}"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelAltBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="132"
                        Content="Reset defaults"
                        Margin="0,0,8,0"
                        Click="ResetButton_Click" />
                <Button Width="96"
                        Content="Close"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
