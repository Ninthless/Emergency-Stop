<Window x:Class="EmergencyStop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emergency Stop 设置"
        Width="420"
        Height="620"
        MinWidth="380"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#101820"
        Foreground="#E7EEF6"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7EEF6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7EEF6" />
            <Setter Property="Margin" Value="0,6,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
    </Window.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <TextBlock Text="Emergency Stop"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <TextBlock Text="屏幕急停指示器"
                           Foreground="#9FB0C3"
                           Margin="0,0,0,18" />

                <CheckBox Content="显示覆盖层"
                          IsChecked="{Binding IsOverlayVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="鼠标穿透"
                          IsChecked="{Binding IsClickThrough, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="显示键位小面板"
                          IsChecked="{Binding ShowDirectionPad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="启动时打开设置"
                          IsChecked="{Binding OpenSettingsOnStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Separator Margin="0,14,0,16" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="指示器大小" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat={}{0:0}px}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="SizeSlider"
                        Minimum="96"
                        Maximum="260"
                        Value="{Binding IndicatorSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="透明度" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="OpacitySlider"
                        Minimum="0.25"
                        Maximum="1"
                        Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="松键急停估算" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=ReleaseSlider, Path=Value, StringFormat={}{0:0}ms}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="ReleaseSlider"
                        Minimum="35"
                        Maximum="220"
                        Value="{Binding ReleaseStopMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="反向急停估算" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=CounterSlider, Path=Value, StringFormat={}{0:0}ms}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="CounterSlider"
                        Minimum="15"
                        Maximum="140"
                        Value="{Binding CounterStopMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="READY 闪烁窗口" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=FlashSlider, Path=Value, StringFormat={}{0:0}ms}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="FlashSlider"
                        Minimum="25"
                        Maximum="180"
                        Value="{Binding ReadyFlashMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="水平偏移" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=OffsetXSlider, Path=Value, StringFormat={}{0:0}px}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="OffsetXSlider"
                        Minimum="-640"
                        Maximum="640"
                        Value="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="垂直偏移" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ElementName=OffsetYSlider, Path=Value, StringFormat={}{0:0}px}"
                               Foreground="#9FB0C3" />
                </Grid>
                <Slider x:Name="OffsetYSlider"
                        Minimum="-360"
                        Maximum="360"
                        Value="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Separator Margin="0,14,0,16" />

                <TextBlock Text="移动键位"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <UniformGrid Columns="2" Rows="2">
                    <Button x:Name="ForwardKeyButton"
                            Tag="Forward"
                            Click="KeyButton_Click" />
                    <Button x:Name="BackwardKeyButton"
                            Tag="Backward"
                            Click="KeyButton_Click" />
                    <Button x:Name="LeftKeyButton"
                            Tag="Left"
                            Click="KeyButton_Click" />
                    <Button x:Name="RightKeyButton"
                            Tag="Right"
                            Click="KeyButton_Click" />
                </UniformGrid>
                <TextBlock x:Name="CaptureHint"
                           Text="点击按钮后按下新的移动键"
                           Foreground="#9FB0C3"
                           Margin="0,8,0,12" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Content="恢复默认"
                            Click="ResetButton_Click" />
                    <Button Grid.Column="2"
                            Content="关闭"
                            Click="CloseButton_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
